# Public site origin — no trailing slash. Used by sitemap, robots.txt, and metadata.
NEXT_PUBLIC_SITE_URL=https://bhutanmotorcycletours.com

# Enquiry delivery via Resend (resend.com). Without RESEND_API_KEY the API runs in MOCK mode and says so to the user.
RESEND_API_KEY=
# Sender: must be on a domain verified in Resend.
ENQUIRY_FROM_EMAIL=Bhutan Motorcycle Tours <enquiries@bhutanmotorcycletours.com>
# Optional: comma-separated recipients. Defaults to the contact emails in src/lib/content.ts.
ENQUIRY_TO_EMAIL=info@bhutanmindvacation.com,mindvacationtoursbhutan@gmail.com
